# Copy this file to .env.local and fill in your real Formspree form ID.
# Get this from formspree.io after creating a form pointed at enjrenovationsltd@gmail.com.
# The ID is the part after /f/ in your form's endpoint URL, e.g. https://formspree.io/f/abcdwxyz
FORMSPREE_FORM_ID=

# The site's public production URL. Used for SEO metadata, Open Graph tags,
# sitemap.xml, and robots.txt. Update this if you attach a custom domain.
NEXT_PUBLIC_SITE_URL=https://en-jrenovationsweb.vercel.app
